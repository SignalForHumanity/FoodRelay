[Unit]
Description=FoodRelay Node
After=network.target

[Service]
Type=simple
User=foodrelay
WorkingDirectory=/opt/foodrelay
EnvironmentFile=/opt/foodrelay/.env
ExecStart=/opt/foodrelay/node
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/foodrelay

[Install]
WantedBy=multi-user.target
