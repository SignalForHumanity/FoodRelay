# ── Node configuration ────────────────────────────────────────────────────────
NODE_ID=node-cityname-01
NODE_PHONE=+15551234567
NODE_ADDR=:8080
NODE_DB_PATH=./node.db

# Comma-separated admin phones — escalation alerts go here
ADMIN_PHONES=+15559876543

# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_PHONE=+15551234567

# Registry — comma-separated list of registry URLs to announce/heartbeat to.
# REGISTRY_URLS takes precedence; REGISTRY_URL is kept for backwards compatibility.
REGISTRY_URLS=http://localhost:8081
# REGISTRY_URL=http://localhost:8081  (legacy — use REGISTRY_URLS instead)

# Node geo (lat/lon for map discovery)
NODE_LAT=40.7128
NODE_LON=-74.0060
NODE_COVERAGE_KM=10

# ed25519 key seed (hex, 32 bytes). Generated and printed on first run.
# Copy the printed value here so it persists across restarts.
NODE_PRIVATE_KEY_HEX=

# Minutes a READY offer can go unmatched before admin alert
READY_ESCALATE_MINUTES=30

# Run an embedded registry server inside this node process (combined mode).
NODE_RUN_REGISTRY=false

# ── Registry configuration ────────────────────────────────────────────────────
REGISTRY_ADDR=:8081
REGISTRY_DB_PATH=./registry.db

# Peer registry URLs for gossip federation (comma-separated, registry-side).
# Each registry pulls from its peers every 5 minutes.
REGISTRY_PEERS=
